# Copy to .env.local and fill in the real values (never commit .env.local).

# EZAFF Publisher API — server-only. Used only inside src/lib/ezaff.ts and
# src/app/api/lead/route.ts. Must never be exposed to the browser, so it
# must never be prefixed with NEXT_PUBLIC_.
EZAFF_API_KEY=
EZAFF_PUBLISHER_ID=
EZAFF_OFFER_ID=

# EZAFF Postback — server-only. Used only inside src/lib/ezaffPostback.ts and
# src/app/api/ezaff/postback/route.ts. EZAFF's postback URLs include this as
# a `secret=` query param so the (publicly reachable) endpoint can tell a
# real EZAFF callback apart from an arbitrary internet request. Must never be
# exposed to the browser — never prefix with NEXT_PUBLIC_. Generate a long
# random value, e.g. `openssl rand -hex 32`.
EZAFF_POSTBACK_SECRET=

# Postgres connection string — server-only, used by src/lib/db.ts. A pooled
# connection string from a managed provider (Neon, Vercel Postgres) is
# expected, e.g. postgres://user:password@host/dbname?sslmode=require.
# Never commit the real value; never expose to the browser. After setting
# this, run `npm run db:migrate` to create the tables (see db/schema.sql).
DATABASE_URL=

# Meta Pixel / Dataset ID — browser-visible BY DESIGN, used inside
# src/components/tracking/MetaPixel.tsx (browser Pixel) AND src/lib/metaCapi.ts
# (server-side Conversions API — the same numeric ID is the CAPI dataset id
# too). This ID itself is NOT a secret. NEXT_PUBLIC_ is correct here. Get the
# value from Meta Events Manager (business.facebook.com/events_manager2) ->
# your Pixel/Dataset -> Settings — the numeric ID shown there, also visible
# as the `fbq('init', '...')` argument in the Pixel's own base code snippet.
# Leave empty and the site runs fine with no Pixel loaded and no CAPI call
# sent (see MetaPixel.tsx / metaCapi.ts — both no-op with no ID).
NEXT_PUBLIC_META_PIXEL_ID=

# Meta Conversions API access token — server-only, used only inside
# src/lib/metaCapi.ts, called from src/app/api/lead/route.ts. This IS a
# secret: must NEVER be prefixed NEXT_PUBLIC_ and must never be imported
# from a "use client" file. Generate it in Events Manager -> your
# Pixel/Dataset -> Settings -> Conversions API -> "Generate access token".
# Leave empty and the server-side Lead event is simply not sent (browser
# Pixel keeps working on its own — see metaCapi.ts isMetaCapiConfigured()).
META_CAPI_ACCESS_TOKEN=

# Rate limiting — server-only, used only inside src/lib/rateLimit.ts. HMAC
# key for hashing client IPs before they're stored in
# lead_submission_attempts — the raw IP is never written to that table.
# Generate a long random value, e.g. `openssl rand -hex 32`.
RATE_LIMIT_SECRET=

# Cloudflare Turnstile — bot/spam protection for POST /api/lead. The site
# key is browser-visible by design (NEXT_PUBLIC_); the secret key is
# server-only and must NEVER be prefixed NEXT_PUBLIC_. Get both from the
# Cloudflare dashboard -> Turnstile -> add a site. Until BOTH are set, the
# app runs with Turnstile verification transparently skipped (see
# src/lib/turnstile.ts and src/components/TurnstileWidget.tsx) — this is a
# deliberate safe default so missing keys can never block real leads. Once
# both are set (locally and in Vercel) verification becomes mandatory.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
