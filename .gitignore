# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.local holds real secrets (EZAFF_API_KEY etc.) and must
# never be committed; .env.example is the opt-in exception so contributors
# know which variables to set.
.env*
!.env.example

# vercel
.vercel

# claude code / tooling
.claude/
.playwright-mcp/

# typescript
*.tsbuildinfo
next-env.d.ts
